# 默认环境变量 (会被 .env.development / .env.production 覆盖)
NODE_ENV=development

# 应用
APP_PORT=8083
APP_NAME=web-see-backend

# JWT
JWT_SECRET=web-see-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 数据库
DATABASE_URL="mysql://root:bridge666@localhost:3306/web_see"

# 前端 dist 静态文件路径 (相对于 backend 目录)
DIST_PATH=../dist
