# 默认环境变量 (会被 .env.development / .env.production 覆盖)
NODE_ENV=development

# 应用
APP_PORT=8083
APP_NAME=web-see-backend

# JWT
JWT_SECRET=web-see-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 数据库
DATABASE_URL="mysql://root:bridge666@localhost:3306/web_see"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 前端 dist 静态文件路径 (相对于 backend 运行目录)
DIST_PATH=../../sentry/web-see-demo/dist

# Source map CI/CD 上传专用密钥（只用于 /uploadmap，不授予其他权限）
SOURCEMAP_UPLOAD_SECRET=4ccb6719139044c2d94b4cf1655f0cd3ba65379e173709872c35b77d46b6f141

