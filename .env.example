# ===== 应用 =====
NODE_ENV=development
APP_PORT=8083
APP_NAME=web-see-backend

# ===== JWT(必填,无默认值;缺失则拒绝启动)=====
# 生成: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== 数据库 =====
DATABASE_URL=mysql://user:password@localhost:3306/web_see

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 日志 =====
LOG_LEVEL=info

# ===== SourceMap 上传(CI/CD 用,留空则上传接口关闭)=====
DIST_PATH=../dist
SOURCEMAP_UPLOAD_SECRET=

# ===== MinIO 对象存储 =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sourcemaps

RECORD_SCREEN_ENC_KEY=
