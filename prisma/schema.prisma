// ============================================================
// Prisma Schema  —  web-see 前端监控平台
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 枚举
// ============================================================

enum Role {
  ADMIN
  USER
}

// ============================================================
// 用户表 (鉴权/权限)
// ============================================================
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("users")
}

// ============================================================
// 项目表 (apikey 管理)
// ============================================================
model Project {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  apikey         String   @unique @db.VarChar(64)
  description    String?  @db.VarChar(255)
  allowedOrigins String   @default("[]") @map("allowed_origins") @db.VarChar(2000)
  ownerId        Int      @map("owner_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("projects")
}

// ============================================================
// 错误上报表
// type: error | unhandledrejection | resourceError | httpError
// ============================================================
model ErrorReport {
  id             Int      @id @default(autoincrement())
  type           String   @db.VarChar(50)
  message        String?  @db.Text
  pageUrl        String?  @map("page_url") @db.VarChar(500)
  time           BigInt?
  apikey         String   @db.VarChar(64)
  monitorUserId  String?  @map("monitor_user_id") @db.VarChar(100)
  sdkVersion     String?  @map("sdk_version") @db.VarChar(20)
  deviceInfo     Json?    @map("device_info")
  recordScreenId String?  @map("record_screen_id") @db.VarChar(64)
  fileName       String?  @map("filename") @db.VarChar(500)
  lineNo         Int?     @map("line_no")
  colNo          Int?     @map("col_no")
  // ── 网络请求错误(httpError)专用字段; 其它错误类型留空 ──
  // SDK 上报为 web-see 嵌套结构(requestData:{httpType,method,url,data} + response:{status,data}),
  // 在 ReportService.saveError 内提取。requestData/responseData 用 Text 配合 truncate 体积兜底防 P2000。
  requestUrl     String?  @map("request_url") @db.VarChar(500)
  requestMethod  String?  @map("request_method") @db.VarChar(10)  // GET/POST...
  httpType       String?  @map("http_type") @db.VarChar(10)       // xhr | fetch
  requestData    String?  @map("request_data") @db.Text           // 请求参数/body(字符串化后存)
  responseStatus Int?     @map("response_status")                 // 响应状态码
  responseData   String?  @map("response_data") @db.Text          // 响应体(字符串化后存)
  elapsedTime    Int?     @map("elapsed_time")                    // 请求耗时(ms)
  errorGroupId   Int?     @map("error_group_id")
  createdAt      DateTime @default(now()) @map("created_at")

  breadcrumbs Breadcrumb[]
  errorGroup  ErrorGroup? @relation(fields: [errorGroupId], references: [id], onDelete: SetNull)

  @@index([apikey])
  @@index([type])
  @@index([recordScreenId])
  @@index([errorGroupId])
  @@index([createdAt])
  @@map("error_reports")
}

// ============================================================
// 错误聚合分组表 (同一 fingerprint 归为一组, 用于去重/统计)
// fingerprint = sha1(type|归一化message|userId)
// 不含 fileName/lineNo/colNo: 生产构建文件名带 contenthash、压缩后行列号每次发版都变,
// 带上会导致同一错误每次发版被拆成新组; 项目维度由 @@unique([apikey, fingerprint]) 保证。
// ============================================================
model ErrorGroup {
  id          Int      @id @default(autoincrement())
  apikey      String   @db.VarChar(64)
  fingerprint String   @db.VarChar(64)
  type        String   @db.VarChar(50)
  message     String?  @db.Text
  fileName    String?  @map("filename") @db.VarChar(500)
  lineNo      Int?     @map("line_no")
  colNo       Int?     @map("col_no")
  count       Int      @default(1)
  firstSeen   DateTime @default(now()) @map("first_seen")
  lastSeen    DateTime @default(now()) @map("last_seen")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reports ErrorReport[]

  @@unique([apikey, fingerprint])
  @@index([apikey])
  @@index([type])
  @@index([lastSeen])
  @@map("error_groups")
}

// ============================================================
// 用户行为轨迹表 (归属于某条错误记录)
// category: Click | Http | Code_Error | Resource_Error | Route
// ============================================================
model Breadcrumb {
  id            Int      @id @default(autoincrement())
  errorReportId Int      @map("error_report_id")
  category      String?  @db.VarChar(50)
  data          Json?
  status        String?  @db.VarChar(20)
  time          BigInt?
  message       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  errorReport ErrorReport @relation(fields: [errorReportId], references: [id], onDelete: Cascade)

  @@index([errorReportId])
  @@map("breadcrumbs")
}

// ============================================================
// 性能数据上报表
// 包含 Web Vitals: FP/FCP/LCP/FID/CLS/TTFB 及网络时序
// ============================================================
model PerformanceReport {
  id            Int      @id @default(autoincrement())
  pageUrl       String?  @map("page_url") @db.VarChar(500)
  time          BigInt?
  apikey        String   @db.VarChar(64)
  monitorUserId String?  @map("monitor_user_id") @db.VarChar(100)
  sdkVersion    String?  @map("sdk_version") @db.VarChar(20)
  deviceInfo    Json?    @map("device_info")
  // Web Vitals (毫秒)
  fp            Decimal? @db.Decimal(10, 2)
  fcp           Decimal? @db.Decimal(10, 2)
  lcp           Decimal? @db.Decimal(10, 2)
  fid           Decimal? @db.Decimal(10, 2)
  cls           Decimal? @db.Decimal(10, 4)
  ttfb          Decimal? @db.Decimal(10, 2)
  // 网络时序 (毫秒)
  dns           Decimal? @db.Decimal(10, 2)
  tcp           Decimal? @db.Decimal(10, 2)
  ssl           Decimal? @db.Decimal(10, 2)
  loadTime      Decimal? @map("load_time") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([apikey])
  @@index([createdAt])
  @@map("performance_reports")
}

// ============================================================
// 录屏数据表 (rrweb 压缩事件流)
// ============================================================
model RecordScreen {
  id             Int      @id @default(autoincrement())
  recordScreenId String   @map("record_screen_id") @db.VarChar(64)
  // events 大字段存 MinIO,DB 仅存对象 key(eventsKey)+ 字节数(eventsSize)。SDK 上报的
  // events 本就是客户端 gzip+base64 的不透明 blob,后端只存不解析,属"写一次/读极少/体积大"
  // 场景,放对象存储避免撑大 InnoDB buffer pool/备份/复制。读取时按 eventsKey 从 MinIO 取回。
  eventsKey      String?  @map("events_key") @db.VarChar(512)
  eventsSize     Int?     @map("events_size")
  apikey         String?  @db.VarChar(64)
  monitorUserId  String?  @map("monitor_user_id") @db.VarChar(100)
  pageUrl        String?  @map("page_url") @db.VarChar(500)
  time           BigInt?
  createdAt      DateTime @default(now()) @map("created_at")

  // 去重/唯一键按 (apikey, recordScreenId) 复合,而非 recordScreenId 全局唯一。
  // recordScreenId 由客户端 SDK 生成,若全局唯一,攻击者用自己合法 apikey + 他人的
  // recordScreenId 上报即可 upsert 命中并覆盖他人录屏(跨租户数据污染)。复合唯一后
  // 不同租户各自独立去重,跨租户的同名 ID 落为各自名下的独立行。(同 ErrorGroup 的
  // @@unique([apikey, fingerprint]) 隔离理念)
  @@unique([apikey, recordScreenId])
  @@index([recordScreenId])
  @@map("record_screens")
}

// ============================================================
// SourceMap 元数据表 (前端 CI/CD 上传，内容存 MinIO，此表仅记录索引)
// ============================================================
model SourceMapFile {
  id        Int      @id @default(autoincrement())
  fileName  String   @db.VarChar(255)
  apikey    String   @db.VarChar(64)
  minioKey  String   @map("minio_key") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fileName, apikey])
  @@index([apikey])
  @@map("source_map_files")
}

// ============================================================
// 性能日聚合统计表（原始数据 30 天后归档到此，最长保留 1 年）
// ============================================================
model PerformanceDailyStat {
  id          Int      @id @default(autoincrement())
  statDate    DateTime @map("stat_date") @db.Date
  apikey      String   @db.VarChar(64)
  sampleCount Int      @map("sample_count")
  avgFp       Decimal? @map("avg_fp") @db.Decimal(10, 2)
  avgFcp      Decimal? @map("avg_fcp") @db.Decimal(10, 2)
  avgLcp      Decimal? @map("avg_lcp") @db.Decimal(10, 2)
  avgFid      Decimal? @map("avg_fid") @db.Decimal(10, 2)
  avgCls      Decimal? @map("avg_cls") @db.Decimal(10, 4)
  avgTtfb     Decimal? @map("avg_ttfb") @db.Decimal(10, 2)
  avgDns      Decimal? @map("avg_dns") @db.Decimal(10, 2)
  avgTcp      Decimal? @map("avg_tcp") @db.Decimal(10, 2)
  avgSsl      Decimal? @map("avg_ssl") @db.Decimal(10, 2)
  avgLoadTime Decimal? @map("avg_load_time") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([statDate, apikey])
  @@index([apikey])
  @@index([statDate])
  @@map("performance_daily_stats")
}

// ============================================================
// 白屏检测数据表
// ============================================================
model WhiteScreen {
  id            Int      @id @default(autoincrement())
  pageUrl       String?  @map("page_url") @db.VarChar(500)
  time          BigInt?
  apikey        String?  @db.VarChar(64)
  monitorUserId String?  @map("monitor_user_id") @db.VarChar(100)
  sdkVersion    String?  @map("sdk_version") @db.VarChar(20)
  deviceInfo    Json?    @map("device_info")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([apikey])
  @@index([createdAt])
  @@map("white_screens")
}
